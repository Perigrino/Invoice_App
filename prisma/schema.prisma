generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// An anonymous workspace. There are no accounts: the browser holds a
/// `invoiceflow_ws` cookie and every row in this database belongs to exactly
/// one workspace. Nothing else identifies a visitor.
model Workspace {
  id        String    @id
  createdAt DateTime  @default(now())
  company   Company?
  clients   Client[]
  invoices  Invoice[]
  settings  Setting?
}

model Company {
  id          String    @id @default(cuid())
  name        String?
  logo        String?
  address     String?
  email       String?
  phone       String?
  website     String?
  taxId       String?
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Client {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fullName    String
  company     String?
  email       String?
  phone       String?
  address     String?
  taxId       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoices    Invoice[]

  @@index([workspaceId])
}

model Invoice {
  id            String            @id @default(cuid())
  workspaceId   String
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceNumber String
  invoiceType   String            @default("invoice")
  clientId      String?
  client        Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status        String            @default("draft")
  /// All money columns are integer cents; percentages are stored separately.
  subtotalCents   Int             @default(0)
  discountPercent Float           @default(0)
  discountCents   Int             @default(0)
  taxPercent      Float           @default(0)
  taxCents        Int             @default(0)
  totalCents      Int             @default(0)
  balanceDueCents Int             @default(0)
  notes         String?           @db.Text
  issueDate     DateTime          @default(now())
  dueDate       DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lineItems     InvoiceLineItem[]

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@unique([workspaceId, invoiceNumber])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description     String
  priceCents      Int     @default(0)
  quantity        Float   @default(1)
  discountPercent Float   @default(0)
  taxPercent      Float   @default(0)
  totalCents      Int     @default(0)
  sortOrder       Int     @default(0)
}

/// Fixed-window counters for the write routes. Rows are cheap and pruned.
model RateLimit {
  id          String   @id
  bucketKey   String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([bucketKey, windowStart])
  @@index([windowStart])
}

model Tax {
  id         String @id @default(cuid())
  name       String
  percentage Float  @default(0)
  method     String @default("exclusive")
}

model Setting {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  currency           String    @default("USD")
  separator          String    @default("comma")
  decimalPlaces      Int       @default(2)
  signPlacement      String    @default("before")
  dateFormat         String    @default("MM/DD/YYYY")
  pdfDirectory       String    @default("/exports")
  template           String    @default("modern")
  paperSize          String    @default("A4")
  pdfAccentColor     String    @default("#00BCD4")
  pdfSecondaryColor  String    @default("#059669")
  logo               String    @default("")
  notes              String    @default("")
  showInvoiceId      Boolean   @default(true)
  showDueDate        Boolean   @default(true)
  showCurrency       Boolean   @default(true)
  showDiscount       Boolean   @default(true)
  showTax            Boolean   @default(true)
  showNote           Boolean   @default(true)
  language           String    @default("en")
  sound              String    @default("default")
  muteNotifications  Boolean   @default(false)
  openPdfAfterExport Boolean   @default(true)
  autoSave           Boolean   @default(true)
  darkMode           Boolean   @default(false)

  @@index([workspaceId])
}
